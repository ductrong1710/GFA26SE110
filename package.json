{
  "name": "smart-farm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js && npm run test:credentials",
    "test:credentials": "vitest run tests/gateway-credentials.test.jsx --environment jsdom",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:permissions": "node --test tests/permissions.test.js",
    "test:ui": "node --test tests/ui-state.test.js",
    "test:mock-data": "node --test tests/mock-data.test.js",
    "test:farms": "node --test tests/farm-workspace.test.js",
    "test:management": "node --test tests/management.test.js",
    "test:operations": "node --test tests/operations.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
